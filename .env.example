# Salin ke .env.local untuk pengembangan lokal. JANGAN commit nilai asli.
# Di Hostinger, isi lewat hPanel > Node.js > Environment variables.

# MySQL (di server Hostinger gunakan 127.0.0.1, bukan srvXXXX.hstgr.io)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Token untuk membaca /api/ab/stats (minimal 16 karakter acak)
AB_STATS_TOKEN=
