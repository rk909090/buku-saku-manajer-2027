# Salin ke .env.local untuk pengembangan lokal. JANGAN commit nilai asli.
# Di Hostinger, isi lewat hPanel > Node.js > Environment variables.

# MySQL (di server Hostinger gunakan 127.0.0.1, bukan srvXXXX.hstgr.io)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Token untuk membaca /api/ab/stats (minimal 16 karakter acak)
AB_STATS_TOKEN=

# --- Toko (keranjang, ongkir, pembayaran) ---
# Biteship: Dashboard Biteship > Integrations > API Key (biteship_live.… / biteship_test.…)
BITESHIP_API_KEY=
# Xendit: Dashboard > Settings > API Keys — secret key dengan izin Money-in WRITE (xnd_production_… / xnd_development_…)
XENDIT_SECRET_KEY=
# Xendit: Dashboard > Settings > Webhooks — "Webhook verification token"
XENDIT_WEBHOOK_TOKEN=

# Akun owner pertama dashboard /admin (dipakai HANYA saat tabel admin masih kosong).
# Setelah login pertama, ganti password di dashboard lalu hapus kedua variabel ini.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Email notifikasi (Resend) ---
# Resend: Dashboard > API Keys (re_…). Domain humplus.com harus diverifikasi di Resend (Domains) agar bisa
# mengirim dari noreply@humplus.com.
RESEND_API_KEY=
# Opsional. Default: "Buku Saku Manajer <noreply@humplus.com>"
EMAIL_FROM=
